# Copy to .env; MiaAI-Lab's scripts/config.sh reads it as KEY=value data, never runs it.
# These are the settings behind the numbers in README.md.
IMAGE=sojufx-tensorfold:v127-drafthead2-20261122
CONTAINER_NAME=qwen38-tensorfold
# The NVIDIA PyTorch 26.07 base the measured image was built on, pinned by digest.
BASE_IMAGE=nvcr.io/nvidia/pytorch@sha256:2140e699b3beaf7f96a0081fd9c9406bc3832b435cdb60dfa2d261f7d2f34a1c
SERVED_NAME=ornith
HOST=127.0.0.1
PORT=8001
# HF_CACHE=/path/to/huggingface
# KERNEL_CACHE=/path/to/tensorfold-cache

# Model: NVIDIA FP4-Local; ABLIT=1 adds the gated Keys house-qsa overlay (needs HF_TOKEN), used for the numbers.
CHECKPOINT=nvfp4
MODEL_REVISION=b9ce18a6887e18c089fdea8509a33e63429a3300
ABLIT=1

# Serving
PARALLEL=4
CONTEXT=262144
KV_DTYPE=fp8
THINKING=0
TEMPERATURE=0
TOP_P=0.8
TOP_K=20
VISION=1
PDF=1
VIDEO=1
TENSORFOLD_MAX_IMAGES=50
TENSORFOLD_IMAGE_TOKENS=16384
TENSORFOLD_VIDEO_TOKENS=16384
TENSORFOLD_MEMORY_RESERVE_GIB=10
TENSORFOLD_VISION_WORKSPACE_MIB=2048
TENSORFOLD_NO_UPDATE_CHECK=1

# My changes (patches 0007 to 0009)
TF_FLASHNEXT_HEAD8=1
TF_FLASHNEXT_HEAD8_AUDIT=0
TF_FLASHNEXT_ADAPTIVE_DEPTH=1
TF_FLASHNEXT_ADAPTIVE_MAX=10
TF_FLASHNEXT_ADAPTIVE_COST=0.10
TF_FLASHNEXT_DRAFT_HEAD2=16
TF_FLASHNEXT_COPY_LOG=0

# n-gram table read from the SSD, not held in RAM
TF_FLASHNEXT_PLE_IO=pread
TF_FLASHNEXT_TABLE_WARM=0

# Drafting and engine tuning
TF_FLASHNEXT_DRAFTS=6
TF_FLASHNEXT_CONFIDENCE=-0.4
TF_FLASHNEXT_DRAFT_HEAD=affine4
TF_FLASHNEXT_SHARED_DRAFTS=0
TF_FLASHNEXT_DRAFT_AHEAD=1
TF_FLASHNEXT_KEEP_LATE=1
TF_FLASHNEXT_SAMPLE_CAND=1
TF_FLASHNEXT_SAMPLED_HEADS=1
TF_FLASHNEXT_PRODUCT_STREAMS=5
TF_FLASHNEXT_WARM_AHEAD=1
TF_FLASHNEXT_HOST_DRAW_THREADS=7
TF_FLASHNEXT_SHARED_SIDE=1
TF_FLASHNEXT_GDN_LANES=1
TF_FLASHNEXT_GATHER_EARLY=1
TF_FLASHNEXT_HEAD_PIECE=1536
TF_FLASHNEXT_CHUNK=3072
TF_FLASHNEXT_PREFILL_TAIL=512
TF_FLASHNEXT_PROMPT_HC2=1
TF_FLASHNEXT_PROMPT_GEMM2=1
TF_FLASHNEXT_PROMPT_MX128=1024
TF_FLASHNEXT_PROMPT_EXPERT_TILE=2
TF_FLASHNEXT_PROMPT_EXPERT_TILE_ROWS=256
TF_FLASHNEXT_PROMPT_SHARED_DIRECT=1
