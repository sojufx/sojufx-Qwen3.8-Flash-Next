# Copy to the runtime checkout as .env. Do not commit secrets.
IMAGE="vllm/vllm-openai:qwen38-flash-next"
SERVED_MODEL_NAME="qwen3.8-flash-next"

# Native model context.
YARN=0
MAX_MODEL_LEN=262144
YARN_MAX_MODEL_LEN=524288

# Validated decode profile.
MTP_NUM_SPECULATIVE_TOKENS=3
MTP_DRAFT_VOCAB="files/draft_vocab_en_code_47k.txt"
KV_CACHE_DTYPE=fp8
MAMBA_SSM_CACHE_DTYPE=bfloat16
MAX_NUM_SEQS=8
CUDAGRAPH_CAPTURE_SIZES=auto
MAX_NUM_BATCHED_TOKENS=2048
COMPILATION_MODE=0
EXTRA_DOCKER_ARGS="-e VLLM_USE_V2_MODEL_RUNNER=1"

# GB10 unified-memory safety guardrails.
KV_TARGET_GIB=20
HOST_RESERVE_GIB=26
HOST_SLACK_GIB=5
REQUIRE_IDLE_GPU=false
# Keep the internal upstream stable as models change. The public gateway stays
# on https://ai.sojufx.com/v1 and forwards to this loopback-only port.
PORT=8001
