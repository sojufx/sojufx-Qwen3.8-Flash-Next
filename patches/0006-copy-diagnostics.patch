diff --git a/zig/src/core/lanes/copy_log.zig b/zig/src/core/lanes/copy_log.zig
new file mode 100644
index 000000000..5cd60eedf
--- /dev/null
+++ b/zig/src/core/lanes/copy_log.zig
@@ -0,0 +1,44 @@
+const std = @import("std");
+const Kind = @import("windows.zig").Kind;
+const kinds = std.enums.values(Kind);
+
+pub const Log = struct {
+    mode: ?u8 = null,
+    calls: usize = 0,
+    detailed: usize = 0,
+    counts: [kinds.len]Counts = @splat(.{}),
+
+    const Counts = struct {
+        windows: u64 = 0,
+        rows: u64 = 0,
+        kept: u64 = 0,
+        full: u64 = 0,
+    };
+
+    pub fn record(log: *Log, kind: Kind, rows: usize, kept: usize) void {
+        const mode = log.mode orelse blk: {
+            const value = if (std.c.getenv("TF_FLASHNEXT_COPY_LOG")) |text| text[0] else 0;
+            log.mode = value;
+            break :blk value;
+        };
+        if (mode != '1' and mode != '2') return;
+        if (mode == '2' and kind == .copy and log.detailed < 1200) {
+            std.debug.print("COPYDETAIL rows={d} kept={d}\n", .{ rows, kept });
+            log.detailed += 1;
+        }
+        const count = &log.counts[@intFromEnum(kind)];
+        count.windows += 1;
+        count.rows += rows;
+        count.kept += kept;
+        if (rows > 1 and kept == rows - 1) count.full += 1;
+        log.calls += 1;
+        if (log.calls < 400) return;
+        std.debug.print("COPYLOG", .{});
+        for (kinds, log.counts) |tag, total| if (total.windows > 0) {
+            std.debug.print(" {s}: win={d} rows={d} kept={d} full={d};", .{ @tagName(tag), total.windows, total.rows, total.kept, total.full });
+        };
+        std.debug.print("\n", .{});
+        log.calls = 0;
+        log.counts = @splat(.{});
+    }
+};
