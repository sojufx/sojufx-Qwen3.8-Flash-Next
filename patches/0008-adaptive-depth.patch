+pub const ChainRate = struct {
+    landed: f64 = 3.4,
+    tested: f64 = 4,
+
+    pub fn observe(rate: *ChainRate, proposed: usize, accepted: usize) void {
+        if (proposed == 0) return;
+        rate.landed = 0.85 * rate.landed + @as(f64, @floatFromInt(accepted));
+        rate.tested = 0.85 * rate.tested + @as(f64, @floatFromInt(@min(proposed, accepted + 1)));
+    }
+
+    pub fn best(rate: ChainRate, maximum: usize, cost: f64) usize {
+        const probability = rate.landed / rate.tested;
+        var depth: usize = 0;
+        var reach: f64 = 1;
+        var expected: f64 = 1;
+        var best_rate: f64 = 0;
+        for (0..maximum) |index| {
+            reach *= probability;
+            expected += reach;
+            const score = expected / (1 + cost * @as(f64, @floatFromInt(index)));
+            if (score > best_rate) {
+                depth = index + 1;
+                best_rate = score;
+            }
+        }
+        return depth;
     }
+
+    pub fn raised(rate: ChainRate, floor: usize, maximum: usize, cost: f64) usize {
+        if (maximum <= floor or rate.landed < 0.95 * rate.tested) return floor;
+        return @max(floor, rate.best(maximum, cost));
+    }
 };
 
