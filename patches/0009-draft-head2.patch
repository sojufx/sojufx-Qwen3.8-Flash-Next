+        const uint16_t key = keys[0];
+        const uint16_t raw = key == 0 ? 0xff80 : key & 0x8000 ? key & 0x7fff : ~key;
+        partial[0] = __uint_as_float(static_cast<uint32_t>(raw) << 16);
+    }
+    __syncthreads();
+    const float top = partial[0];
+    __syncthreads();
