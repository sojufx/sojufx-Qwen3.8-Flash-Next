diff --git a/zig/src/families/flashnext/cuda_draft2.zig b/zig/src/families/flashnext/cuda_draft2.zig
new file mode 100644
index 0000000..c800258
--- /dev/null
+++ b/zig/src/families/flashnext/cuda_draft2.zig
@@ -0,0 +1,192 @@
+const std = @import("std");
+const cuda = @import("cuda");
+const wt = @import("cuda_prompt_wt.zig");
+const dims = wt.dims;
+const groups = dims / 32;
+const tile = 64;
+const chunk = 1024;
+const max_lanes = 16;
+
+pub fn shortlist() !usize {
+    const raw = std.c.getenv("TF_FLASHNEXT_DRAFT_HEAD2") orelse return 0;
+    const value = std.mem.span(raw);
+    if (std.mem.eql(u8, value, "0")) return 0;
+    if (std.mem.eql(u8, value, "8")) return 8;
+    if (std.mem.eql(u8, value, "16")) return 16;
+    return error.BadDraftHead2;
+}
+
+fn promote(bits: u16) f32 {
+    return @bitCast(@as(u32, bits) << 16);
+}
+
+fn code(x: f32) u16 {
+    return @intFromFloat(@round(std.math.clamp(x, 0, 3)));
+}
+
+const Fit = struct { step: f32, offset: f32 };
+
+fn fit(hist: [16]u8, lo: u8, hi: u8) Fit {
+    if (hi == lo) return .{ .step = 1, .offset = @floatFromInt(lo) };
+    const initial: Fit = .{ .step = @as(f32, @floatFromInt(hi - lo)) / 3, .offset = @floatFromInt(lo) };
+    var best = initial;
+    var best_error = std.math.inf(f32);
+    for ([_]f32{ 1.0, 0.8 }) |factor| {
+        var form: Fit = .{ .step = initial.step * factor, .offset = initial.offset + initial.step * 1.5 * (1 - factor) };
+        for (0..4) |_| {
+            var sq: f32 = 0;
+            var sq2: f32 = 0;
+            var sv: f32 = 0;
+            var sqv: f32 = 0;
+            var err: f32 = 0;
+            for (hist, 0..) |count, val| {
+                if (count == 0) continue;
+                const weight: f32 = @floatFromInt(count);
+                const value: f32 = @floatFromInt(val);
+                const q: f32 = @floatFromInt(code((value - form.offset) / form.step));
+                sq += weight * q;
+                sq2 += weight * q * q;
+                sv += weight * value;
+                sqv += weight * q * value;
+                const residual = value - (form.step * q + form.offset);
+                err += weight * residual * residual;
+            }
+            if (err < best_error) {
+                best = form;
+                best_error = err;
+            }
+            const denom = 32 * sq2 - sq * sq;
+            if (denom <= 0) break;
+            const step = (32 * sqv - sq * sv) / denom;
+            if (step <= 0) break;
+            form = .{ .step = step, .offset = (sv - step * sq) / 32 };
+        }
+    }
+    return best;
+}
+
+pub fn pack(a: std.mem.Allocator, d: *const cuda.Driver, words: []const u8, scales: []const u8, biases: []const u8, n: usize) !wt.Q4 {
+    const padded = (n + 127) / 128 * 128;
+    const bits = try a.alloc(u16, padded * dims / 8);
+    defer a.free(bits);
+    const tables = try a.alloc(u16, 2 * padded * groups);
+    defer a.free(tables);
+    @memset(bits, 0);
+    @memset(tables, 0);
+    for (0..n) |col| {
+        for (0..groups) |group| {
+            const at = (col * groups + group) * 16;
+            var hist: [16]u8 = @splat(0);
+            var lo: u8 = 15;
+            var hi: u8 = 0;
+            var raw: [32]u8 = undefined;
+            for (words[at..][0..16], 0..) |pair, index| {
+                raw[index * 2] = pair & 15;
+                raw[index * 2 + 1] = pair >> 4;
+            }
+            for (raw) |value| {
+                hist[value] += 1;
+                lo = @min(lo, value);
+                hi = @max(hi, value);
+            }
+            const form = fit(hist, lo, hi);
+            const src = (col * groups + group) * 2;
+            const affine_scale = promote(std.mem.readInt(u16, scales[src..][0..2], .little));
+            const affine_bias = promote(std.mem.readInt(u16, biases[src..][0..2], .little));
+            const dst = group * padded + col;
+            const bf16 = @import("core").bf16_round.bits;
+            tables[dst] = bf16(form.step * affine_scale);
+            tables[padded * groups + dst] = bf16(@mulAdd(f32, form.offset, affine_scale, affine_bias));
+            const base = ((col / tile * groups + group) * tile + col % tile) * 4;
+            const offsets = [_]usize{ 0, 8, 16, 24, 1, 9, 17, 25 };
+            for (0..4) |part| {
+                var packed_word: u16 = 0;
+                for (offsets, 0..) |offset, index| {
+                    const value: f32 = @floatFromInt(raw[2 * part + offset]);
+                    packed_word |= code((value - form.offset) / form.step) << @intCast(index * 2);
+                }
+                bits[base + part] = packed_word;
+            }
+        }
+    }
+    var weight = wt.Q4.empty(d);
+    errdefer weight.free();
+    weight.w = try cuda.DeviceBuffer.fromHost(d, std.mem.sliceAsBytes(bits));
+    weight.s = try cuda.DeviceBuffer.fromHost(d, std.mem.sliceAsBytes(tables[0 .. padded * groups]));
+    weight.b = try cuda.DeviceBuffer.fromHost(d, std.mem.sliceAsBytes(tables[padded * groups ..]));
+    weight.n = n;
+    weight.k = dims;
+    return weight;
+}
+
+pub const Kernels = struct {
+    module: cuda.Module,
+    dot: cuda.Function,
+    local: cuda.Function,
+    merge: cuda.Function,
+    rescore: cuda.Function,
+    scratch: cuda.DeviceBuffer,
+    tiles: usize,
+    count: usize,
+
+    pub fn load(driver: *const cuda.Driver, mtp: cuda.Module, n: usize, count: usize) !Kernels {
+        const tiles = (n + chunk - 1) / chunk;
+        if (tiles * count > 1280) return error.UnexpectedTensor;
+        var module = try cuda.Module.load(driver, cuda.kernels.qmm);
+        errdefer module.unload();
+        return .{
+            .module = module,
+            .dot = try module.function("_ZN6tf_qmm10qmm_kernelILin32ELi16ELi64ELi1ELi4ELi4ELb0ELb0ELb0EEEvPK13__nv_bfloat16PKfPKjS3_S3_PvPfiiiiiii"),
+            .local = try mtp.function("fn_draft2_local"),
+            .merge = try mtp.function("fn_draft2_merge"),
+            .rescore = try mtp.function("fn_draft2_rescore"),
+            .scratch = try cuda.DeviceBuffer.alloc(driver, max_lanes * (tiles * 8 + tiles * count * 6 + count * 4 + 16)),
+            .tiles = tiles,
+            .count = count,
+        };
+    }
+
+    pub fn free(self: *Kernels) void {
+        self.scratch.free();
+        self.module.unload();
+    }
+
+    pub fn run(self: Kernels, st: cuda.Stream, weight: wt.Q4, affine: wt.Q4, x: u64, sums: u64, logits: u64, rows: usize) !u64 {
+        if (rows == 0 or rows > max_lanes) return error.UnexpectedTensor;
+        const n = affine.n;
+        const padded = (n + 127) / 128 * 128;
+        const local_cols = self.scratch.ptr;
+        const logsum = local_cols + max_lanes * self.tiles * self.count * 4;
+        const selected = logsum + max_lanes * self.tiles * 8;
+        const result = selected + max_lanes * self.count * 4;
+        const local_scores = result + max_lanes * 16;
+        var args: cuda.Args = .{};
+        for ([_]u64{ x, sums, weight.w.ptr, weight.s.ptr, weight.b.ptr, logits, 0 }) |arg| args.add(arg);
+        for ([_]usize{ rows, n, dims, 1, padded, dims, 1 }) |arg| args.add(@as(c_int, @intCast(arg)));
+        try cuda.launch.launch(self.dot, .{ .grid = .{ .x = @intCast((n + tile - 1) / tile) }, .block = .{ .x = 128 }, .shared = 7424 }, st, &args);
+        args = .{};
+        for ([_]u64{ logits, local_scores, local_cols, logsum }) |arg| args.add(arg);
+        args.add(@as(c_int, @intCast(n)));
+        args.add(@as(c_int, @intCast(self.count)));
+        try cuda.launch.launch(self.local, .{ .grid = .{ .x = @intCast(self.tiles), .y = @intCast(rows) }, .block = .{ .x = 256 } }, st, &args);
+        args = .{};
+        for ([_]u64{ local_scores, local_cols, selected }) |arg| args.add(arg);
+        args.add(@as(c_int, @intCast(self.tiles)));
+        args.add(@as(c_int, @intCast(self.count)));
+        try cuda.launch.launch(self.merge, .{ .grid = .{ .x = @intCast(rows) }, .block = .{ .x = 256 } }, st, &args);
+        args = .{};
+        for ([_]u64{ x, sums, affine.w.ptr, affine.s.ptr, affine.b.ptr, logits, logsum, selected, result }) |arg| args.add(arg);
+        for ([_]usize{ n, padded, dims, self.tiles, self.count }) |arg| args.add(@as(c_int, @intCast(arg)));
+        try cuda.launch.launch(self.rescore, .{ .grid = .{ .x = @intCast(rows) }, .block = .{ .x = @intCast(32 * self.count) } }, st, &args);
+        return result;
+    }
+};
+
+test "fit retains a flat group and exactly maps four equidistant codes" {
+    var hist: [16]u8 = @splat(0);
+    hist[9] = 32;
+    try std.testing.expectEqual(Fit{ .step = 1, .offset = 9 }, fit(hist, 9, 9));
+    hist[9] = 0;
+    for ([_]usize{ 1, 5, 9, 13 }) |index| hist[index] = 8;
+    try std.testing.expectEqual(Fit{ .step = 4, .offset = 1 }, fit(hist, 1, 13));
+}
