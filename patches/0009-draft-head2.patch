+extern "C" __global__ void fn_draft2_merge(const uint16_t* local_scores, const int* local_cols, int* selected,
+                                           int tiles, int k) {
+    using Sort = cub::BlockRadixSort<uint16_t, 256, 5, int>;
+    __shared__ typename Sort::TempStorage storage;
+    uint16_t keys[5];
+    int cols[5];
+    const int count = tiles * k;
+#pragma unroll
+    for (int item = 0; item < 5; ++item) {
+        const int rank = threadIdx.x * 5 + item;
+        keys[item] = rank < count ? local_scores[blockIdx.x * count + rank] : 0;
+        cols[item] = rank < count ? local_cols[blockIdx.x * count + rank] : -1;
+    }
+    Sort(storage).SortDescending(keys, cols);
+#pragma unroll
+    for (int item = 0; item < 5; ++item) {
+        const int rank = threadIdx.x * 5 + item;
+        if (rank < k) selected[blockIdx.x * k + rank] = keys[item] ? cols[item] : -1;
+    }
+}
+
+extern "C" __global__ void fn_draft2_rescore(const __nv_bfloat16* input, const float* sums, const uint32_t* words,
+                                             const __nv_bfloat16* scales, const __nv_bfloat16* biases,
+                                             const __nv_bfloat16* approx, const float2* logsum, const int* selected,
+                                             float* result, int n, int padded, int width, int tiles, int k) {
+    const int row = blockIdx.x;
+    const int thread = threadIdx.x;
+    const int lane = thread & 31;
+    const int rank = thread / 32;
+    const int col = rank < k ? selected[row * k + rank] : -1;
+    const int groups = width / 32;
+    const auto* x = input + row * width;
+    const auto* xs = sums + row * groups;
+    __shared__ float exact[16];
+    __shared__ float old[16];
+    __shared__ float top;
+    __shared__ float mass[32];
+    float acc = 0;
+    if (col >= 0) {
+        const int col8 = col % 8;
+        const int tile8 = (col % 64) / 8;
+        const int offset = (lane % 8) / 2;
+        const int shift = (lane / 8 + (lane & 1) * 4) * 4;
+        const size_t start = static_cast<size_t>(col / 64) * groups * 256 + tile8 * 32 + col8 * 4 + offset;
+        for (int group = 0; group < groups; ++group) {
+            const uint32_t word = words[start + group * 256];
+            float dot = __bfloat162float(x[group * 32 + lane]) * ((word >> shift) & 15);
+            for (int delta = 16; delta; delta >>= 1) dot += __shfl_xor_sync(0xffffffff, dot, delta);
+            if (!lane) {
+                const size_t index = static_cast<size_t>(group) * padded + col;
+                acc = __fmaf_rn(xs[group], __bfloat162float(biases[index]),
+                                __fmaf_rn(dot, __bfloat162float(scales[index]), acc));
+            }
+        }
+    }
+    if (!lane) {
+        exact[rank] = col < 0 ? -CUDART_INF_F : __bfloat162float(__float2bfloat16_rn(acc));
+        old[rank] = col < 0 ? -CUDART_INF_F : __bfloat162float(approx[row * n + col]);
+    }
+    if (thread == 0) {
+        top = -CUDART_INF_F;
+        for (int tile = 0; tile < tiles; ++tile) top = fmaxf(top, logsum[row * tiles + tile].x);
+    }
+    __syncthreads();
+    if (thread < 32) {
+        float sum = 0;
+        for (int tile = thread; tile < tiles; tile += 32) {
+            const float2 stats = logsum[row * tiles + tile];
+            sum += stats.y * expf(stats.x - top);
+        }
+        mass[thread] = sum;
+    }
+    __syncthreads();
+    if (thread == 0) {
+        float best = -CUDART_INF_F;
+        int index = 0x7fffffff;
+        float total = 0, old_top = 0;
+        for (float value : mass) total += value;
+        for (int item = 0; item < k; ++item) {
+            fn_mtp::better(best, index, exact[item], selected[row * k + item]);
+            old_top += expf(old[item] - top);
+        }
+        float sum = fmaxf(0, total - old_top) * expf(top - best);
+        for (int item = 0; item < k; ++item) sum += expf(exact[item] - best);
+        result[row * 4] = best;
+        result[row * 4 + 1] = isfinite(total) ? best + logf(sum) : CUDART_NAN_F;
+        result[row * 4 + 2] = __int_as_float(index);
+        result[row * 4 + 3] = 0;
+    }
+}
