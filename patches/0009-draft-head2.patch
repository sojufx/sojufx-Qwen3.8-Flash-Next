+#pragma unroll
+    for (int item = 0; item < 4; ++item) {
+        if (blockIdx.x * 1024 + thread * 4 + item < n) {
+            sum += isfinite(values[item]) ? expf(values[item] - top) : CUDART_NAN_F;
+        }
+    }
+    for (int offset = 16; offset; offset >>= 1) sum += __shfl_xor_sync(0xffffffff, sum, offset);
+    if ((thread & 31) == 0) partial[thread / 32] = sum;
+    __syncthreads();
+    if (thread == 0) {
+        sum = 0;
+        for (float value : partial) sum += value;
+        logsum[tile] = make_float2(top, sum);
+    }
+#pragma unroll
+    for (int item = 0; item < 4; ++item) {
+        const int rank = thread * 4 + item;
+        if (rank < k) {
+            local_scores[tile * k + rank] = keys[item];
+            local_cols[tile * k + rank] = cols[item];
+        }
+    }
+}
