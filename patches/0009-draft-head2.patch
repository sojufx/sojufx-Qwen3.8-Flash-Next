+extern "C" __global__ void fn_draft2_local(const unsigned short* scores, uint16_t* local_scores, int* local_cols,
+                                            float2* logsum, int n, int k) {
+    using Sort = cub::BlockRadixSort<uint16_t, 256, 4, int>;
+    __shared__ typename Sort::TempStorage storage;
+    __shared__ float partial[8];
+    const int thread = threadIdx.x;
+    const int tile = blockIdx.y * gridDim.x + blockIdx.x;
+    const auto* row = scores + blockIdx.y * n;
+    uint16_t keys[4];
+    int cols[4];
+    float values[4];
+#pragma unroll
+    for (int item = 0; item < 4; ++item) {
+        const int col = blockIdx.x * 1024 + thread * 4 + item;
+        const uint16_t raw = col < n ? row[col] : 0xff80;
+        values[item] = __uint_as_float(static_cast<uint32_t>(raw) << 16);
+        keys[item] = isfinite(values[item]) ? fn_mtp::order_key(raw) : 0;
+        cols[item] = col;
+    }
