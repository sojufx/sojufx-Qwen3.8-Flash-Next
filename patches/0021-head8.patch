index 0000000..bfc9eb2
--- /dev/null
+++ b/zig/src/families/flashnext/cuda_head8.zig
@@ -0,0 +1,119 @@
+//! Opt-in FP8 shortlist and exact BF16 tile rescoring for unconstrained greedy main heads.
+const std = @import("std");
+const cuda = @import("cuda");
+const Tensor = @import("core").safetensors.Tensor;
+const N = 248320;
+const K = 2560;
+const cap = 64;
+const blocks = 243;
+const image align(8) = @embedFile("head8.fatbin").*;
+
+pub fn enabled() bool {
+    return if (std.c.getenv("TF_FLASHNEXT_HEAD8")) |v| std.mem.eql(u8, std.mem.span(v), "1") else false;
+}
+fn auditOn() bool {
+    return if (std.c.getenv("TF_FLASHNEXT_HEAD8_AUDIT")) |v| std.mem.eql(u8, std.mem.span(v), "1") else false;
+}
+pub fn safe(s: anytype) bool {
+    return s.sampling == null and s.grammar == null and s.logprobs == null and s.prompt_logprobs == null;
+}
+pub const Head = struct {
+    mod: cuda.Module,
+    codes: cuda.DeviceBuffer,
+    scales: cuda.DeviceBuffer,
+    tmp: cuda.DeviceBuffer,
+    vals: cuda.DeviceBuffer,
+    ids: cuda.DeviceBuffer,
+    tiles: cuda.DeviceBuffer,
+    audit: cuda.DeviceBuffer,
+    counts: cuda.DeviceBuffer,
+    fp8: cuda.Function,
+    bf16: cuda.Function,
+    local: cuda.Function,
+    merge: cuda.Function,
+    clear: cuda.Function,
+    compare: cuda.Function,
+    auditing: bool,
+
+    pub fn init(driver: *const cuda.Driver, stream: cuda.Stream, t: Tensor) !Head {
+        if (!t.is(.bf16, &.{ N, K })) return error.UnexpectedTensor;
+        var h: Head = undefined;
+        h.mod = try cuda.Module.load(driver, &image);
+        errdefer h.mod.unload();
+        h.codes = try cuda.DeviceBuffer.alloc(driver, N * K);
+        errdefer h.codes.free();
+        h.scales = try cuda.DeviceBuffer.alloc(driver, N * 4);
+        errdefer h.scales.free();
+        h.tmp = try cuda.DeviceBuffer.alloc(driver, cap * N * 4);
+        errdefer h.tmp.free();
+        h.vals = try cuda.DeviceBuffer.alloc(driver, cap * blocks * 64 * 4);
+        errdefer h.vals.free();
+        h.ids = try cuda.DeviceBuffer.alloc(driver, cap * blocks * 64 * 4);
+        errdefer h.ids.free();
+        h.tiles = try cuda.DeviceBuffer.alloc(driver, cap * 64 * 4);
+        errdefer h.tiles.free();
+        h.auditing = auditOn();
+        h.audit = try cuda.DeviceBuffer.alloc(driver, if (h.auditing) cap * N * 2 else 0);
+        errdefer h.audit.free();
+        const zero = [_]u64{ 0, 0 };
+        h.counts = try cuda.DeviceBuffer.fromHost(driver, std.mem.asBytes(&zero));
+        errdefer h.counts.free();
+        h.fp8 = try h.mod.function("_ZN8tf_head811qmmf_kernelILi1ELi16ELi64ELi1ELi4ELi4ELb1ELb0ELb0EEEvPK13__nv_bfloat16PKhS5_fPvPfiiiiiiiPKi");
+        h.bf16 = try h.mod.function("_ZN8tf_head811qmmf_kernelILi4ELi16ELi64ELi1ELi4ELi4ELb0ELb0ELb0EEEvPK13__nv_bfloat16PKhS5_fPvPfiiiiiiiPKi");
+        try h.fp8.allowDynamicShared(24576);
+        try h.bf16.allowDynamicShared(40960);
+        h.local = try h.mod.function("h8_top_local");
+        h.merge = try h.mod.function("h8_top_merge");
+        try h.merge.allowDynamicShared(67584);
+        h.clear = try h.mod.function("h8_clear");
+        h.compare = try h.mod.function("h8_audit");
+        var input = try cuda.DeviceBuffer.fromHost(driver, t.bytes);
+        defer input.free();
+        var a: cuda.Args = .{};
+        a.add(input.ptr); a.add(h.scales.ptr); a.add(@as(c_int, 1));
+        try launch(try h.mod.function("h8_row_scales"), stream, &a, N, 1, 256, 0);
+        a = .{};
+        a.add(input.ptr); a.add(h.codes.ptr); a.add(h.scales.ptr); a.add(@as(c_int, 1));
+        try launch(try h.mod.function("h8_pack"), stream, &a, N * K / 256, 1, 256, 0);
+        try stream.synchronize();
+        std.log.info("HEAD8 loaded FP8 per-row shortlist64 + exact BF16 tiles; audit={}", .{h.auditing});
+        return h;
+    }
+    pub fn deinit(h: *Head) void {
+        h.counts.free(); h.audit.free(); h.tiles.free(); h.ids.free(); h.vals.free(); h.tmp.free();
+        h.scales.free(); h.codes.free(); h.mod.unload();
+    }
+    fn launch(f: cuda.Function, s: cuda.Stream, a: *cuda.Args, gx: usize, gy: usize, threads: usize, sm: usize) !void {
+        try cuda.launch.launch(f, .{ .grid = .{ .x = @intCast(gx), .y = @intCast(gy) }, .block = .{ .x = @intCast(threads) }, .shared = @intCast(sm) }, s, a);
+    }
+    fn projection(h: *Head, s: cuda.Stream, f: cuda.Function, x: u64, w: u64, scales: u64, out: u64, n: usize, tiles: u64) !void {
+        _ = h;
+        var a: cuda.Args = .{};
+        a.add(x); a.add(w); a.add(scales); a.add(@as(f32, 1)); a.add(out); a.add(@as(u64, 0));
+        a.add(@as(c_int, @intCast(n))); a.add(@as(c_int, N)); a.add(@as(c_int, K)); a.add(@as(c_int, 1));
+        a.add(@as(c_int, N)); a.add(@as(c_int, K)); a.add(@as(c_int, 1)); a.add(tiles);
+        try launch(f, s, &a, if (tiles != 0) 64 else ((n + 15) / 16) * (N / 64), 1, 128, if (tiles != 0) 40960 else 24576);
+    }
+    pub fn run(h: *Head, s: cuda.Stream, x: u64, bf16: u64, out: u64, n: usize) !bool {
+        if (n > 16) return false;
+        try h.projection(s, h.fp8, x, h.codes.ptr, h.scales.ptr, h.tmp.ptr, n, 0);
+        var a: cuda.Args = .{};
+        a.add(h.tmp.ptr); a.add(h.vals.ptr); a.add(h.ids.ptr); a.add(@as(c_int, @intCast(n)));
+        try launch(h.local, s, &a, blocks, n, 256, 0);
+        a = .{}; a.add(h.vals.ptr); a.add(h.ids.ptr); a.add(h.tiles.ptr);
+        try launch(h.merge, s, &a, n, 1, 512, 67584);
+        a = .{}; a.add(out); a.add(@as(c_int, @intCast(n)));
+        try launch(h.clear, s, &a, (n * N + 255) / 256, 1, 256, 0);
+        for (0..n) |r| try h.projection(s, h.bf16, x + r * K * 2, bf16, 0, out + r * N * 2, 1, h.tiles.ptr + r * 64 * 4);
+        return true;
+    }
+    pub fn compareRows(h: *Head, s: cuda.Stream, out: u64, n: usize) !void {
+        var a: cuda.Args = .{};
+        a.add(out); a.add(h.audit.ptr); a.add(h.counts.ptr); a.add(@as(c_int, @intCast(n)));
+        try launch(h.compare, s, &a, n, 1, 256, 0);
+        try s.synchronize();
+        var counts: [2]u64 = undefined;
+        try s.d.check(s.d.api.cuMemcpyDtoH_v2(&counts, h.counts.ptr, 16), "head8 audit counts");
+        std.log.info("HEAD8_AUDIT positions={d} disagreements={d}", .{ counts[0], counts[1] });
+    }
+};
