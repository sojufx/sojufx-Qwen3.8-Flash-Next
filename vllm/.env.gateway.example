# For an existing guard proxy implementing the README sampling policy.
# This is separate from the runtime .env; keep credentials outside Git.
VLLM_UPSTREAM=http://127.0.0.1:8001
UPSTREAM_MODEL_ALIAS=qwen3.8-flash-next
PUBLIC_MODEL_ALIAS=qwen3.8-flash-next
MAX_COMPLETION_TOKENS=32768
THINKING_TOKEN_BUDGET=8192
DEFAULT_ENABLE_THINKING=false
SAMPLING_GUARD=1
MIN_TEMPERATURE=0.3
